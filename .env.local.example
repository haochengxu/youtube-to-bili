# 复制本文件为 .env.local 并填入真实值（.env.local 已 gitignore，不会入库）
#   cp .env.local.example .env.local

# 翻译后端：claude（订阅长效 token，便宜模型跑翻译）
TRANSLATOR=claude

# claude 长效 token —— 跑 `claude setup-token` 获取，把整串粘到这里
# 无人值守环境靠它鉴权；不设的话 claude -p 会因桌面 App 托管的 token 过期而 401
CLAUDE_CODE_OAUTH_TOKEN=

# 代理（Clash）。定时任务里 yt-dlp 下 YouTube、claude 连 Anthropic 都走它
YOUTUBE_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897
NO_PROXY=localhost,127.0.0.1,::1,.local
